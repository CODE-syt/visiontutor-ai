# ---- AI Provider Configuration ----
# Choose one of: openai | gemini | qwen | llava
AI_PROVIDER=openai

# API key for whichever provider you select above
AI_API_KEY=your_key_here

# Model name understood by the chosen provider
AI_MODEL=gpt-4o-mini

# Base URL override (useful for Qwen-VL / local LLaVA servers). Leave blank for provider default.
AI_BASE_URL=

# Request timeout (seconds)
AI_TIMEOUT=60

# ---- RAG Configuration ----
ENABLE_RAG=true
KNOWLEDGE_BASE_DIR=../knowledge_base
VECTOR_INDEX_PATH=./app/rag/index.faiss
EMBEDDING_MODEL=text-embedding-3-small

# ---- Database (optional history) ----
ENABLE_HISTORY=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=visiontutor

# ---- App / Security ----
MAX_UPLOAD_MB=8
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
